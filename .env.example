# Hosted backend configuration. Fill secrets and absolute data paths before starting.
NODE_ENV=development
SHIFTMINT_RUNTIME=web
HOST=127.0.0.1
PORT=3001
SHIFTMINT_DATA_DIR=
DATABASE_URL=

# Generate ENCRYPTION_KEY using crypto.randomBytes(32).toString('hex').
# Generate JWT_SECRET and BOOTSTRAP_TOKEN independently using crypto.randomBytes(32).toString('base64').
ENCRYPTION_KEY=
JWT_SECRET=
BOOTSTRAP_TOKEN=

# Optional, comma separated browser origins for a separate frontend.
# Vite /api proxy and deployed same-origin frontend do not need this.
CORS_ORIGINS=
# Only enable behind a trusted proxy; Render blueprint sets 1.
TRUST_PROXY=
LOG_LEVEL=info
# Required for Toast: use the API Access URL granted to your merchant integration.
# TOAST_API_BASE_URL=https://ws-api.toasttab.com

# Optional instance-wide payroll estimate policy (defaults shown).
# Change only after reopening affected calculated periods; recalculate and review.
PAYROLL_ESTIMATED_TAX_RATE=0.22
PAYROLL_WEEKLY_OVERTIME_HOURS=40
# Unset means no additional daily overtime threshold.
PAYROLL_DAILY_OVERTIME_HOURS=

# Optional absolute path to the built frontend; defaults to this release's dist/.
FRONTEND_DIST=
# Desktop-only opt-in local analytics scheduler; hosted scheduling is disabled.
ENABLE_ANALYTICS_SCHEDULER=false
