// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  type        String?
  phone       String?
  website     String?
  ein         String?
  address     String?  // JSON string for address data
  location    String?  // City, State for compliance
  posSystem   String?  // POS system used
  usageIntent String?  // Why they're using ShiftMint
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  businessConfigurations BusinessConfiguration[]
  employees              Employee[]
  shifts                 Shift[]
  users                  User[]
  tipEntries            TipEntry[]
  payrollPeriods        PayrollPeriod[]
  auditLogs             AuditLog[]
  punchEvents           PunchEvent[]
  analyticsEntries      AnalyticsEntry[]
  
  // Enhanced Tip Management Relations
  tipAuditLogs           TipAuditLog[]
  tipPoolDistributions   TipPoolDistribution[]
  complianceCalculations ComplianceCalculation[]
  tipImportLogs          TipImportLog[]

  // Security Relations
  refreshTokens          RefreshToken[]

  @@map("businesses")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  phone                 String?
  firstName             String
  lastName              String
  role                  String    @default("owner")
  passwordHash          String
  lastLoginAt           DateTime?
  preferredPayrollFreq  String    @default("bi-weekly")
  preferredTipStyle     String    @default("hybrid")
  rememberMe            Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  acceptedTerms         Boolean   @default(false)
  acceptedPrivacy       Boolean   @default(false)
  analyticsConsent      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Security Relations
  refreshTokens         RefreshToken[]

  @@map("users")
}

model Employee {
  id                 String    @id @default(cuid())
  businessId         String
  employeeNumber     String
  firstName          String
  lastName           String
  email              String
  phone              String?
  hourlyRate         Float
  role               String
  department         String?
  startDate          DateTime
  terminationDate    DateTime?
  status             String    @default("active") // 'active', 'inactive', 'terminated'
  tipEligible        Boolean   @default(true)
  payType            String    @default("hourly") // 'hourly', 'salary'
  overtimeRate       Float?
  address            String?
  emergencyContact   String?
  emergencyPhone     String?
  taxExemptions      Int       @default(0)
  bankRoutingNumber  String?
  bankAccountNumber  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollEntries     PayrollEntry[]

  @@unique([businessId, email])
  @@unique([businessId, employeeNumber])
  @@map("employees")
}

model BusinessConfiguration {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  timeZone              String    @default("America/New_York")
  payPeriodStartDay     Int       @default(1)
  payPeriodFrequency    String    @default("bi-weekly")
  tipPoolingEnabled     Boolean   @default(true)
  tipOutMethod          String    @default("percentage")
  defaultTipPercentage  Float     @default(18.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_configurations")
}

model Shift {
  id               String      @id @default(cuid())
  businessId       String
  employeeId       String?     // Reference to Employee
  shiftDate        String      // Date as string (YYYY-MM-DD)
  startTime        DateTime
  endTime          DateTime?
  durationMin      Int?
  jobCode          String      @default("server")
  position         String?     // Position/role for this shift
  employeeType     String?     // Type of employee (e.g., "Regular", "Temp", "Contract")
  stationNumber    String?     // Station or section number
  locationId       String      @default("main")
  status           String      @default("active")
  
  // Wage information
  hourlyRate       Float       @default(0)
  regularWage      Float       @default(0)
  overtimeWage     Float       @default(0)
  totalWage        Float       @default(0)
  
  // Sales and tips
  totalSales       Float       @default(0)
  cashSales        Float       @default(0)
  creditCardSales  Float       @default(0)
  totalTips        Float       @default(0)
  cashTips         Float       @default(0)
  creditCardTips   Float       @default(0)
  
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relations
  tipEntries       TipEntry[]
  punchEvents      PunchEvent[]

  @@map("shifts")
}

model TipEntry {
  id            String    @id @default(cuid())
  businessId    String
  employeeId    String?   // Reference to Employee
  shiftId       String?
  amount        Float
  tipType       String    // Enhanced: 'pos_pretax', 'pos_posttax', 'pos_pooled', 'cash', 'credit', 'hourly', 'table_server', 'bulk', 'other'
  source        String    @default("manual") // 'manual', 'pos', 'csv_import', 'bulk_entry', 'auto_hourly'
  tableNumber   String?
  serverName    String?   // For table/server tips
  posTransactionId String? // Link to POS system transaction
  isPooled      Boolean   @default(false)
  poolDistributionId String? // Reference to tip pool distribution
  taxableAmount Float?    // Pre-calculated taxable portion
  notes         String?
  timestamp     DateTime  @default(now())
  
  // Compliance & Processing
  processed     Boolean   @default(false)
  processedAt   DateTime?
  complianceStatus String @default("pending") // 'pending', 'compliant', 'flagged', 'requires_adjustment'
  wageCreditUsed Float   @default(0) // Amount used for wage credit calculation
  irsReportable Boolean  @default(false) // Flag for >$20/month threshold
  
  // Audit Trail
  version       Int       @default(1)
  lastModifiedBy String?
  originalAmount Float?   // Track original amount for audit
  changeReason   String?  // Reason for any modifications
  
  // Legacy fields
  transactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shift         Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  auditHistory  TipAuditLog[]
  poolDistribution TipPoolDistribution? @relation(fields: [poolDistributionId], references: [id], onDelete: SetNull)

  @@map("tip_entries")
}

model PayrollPeriod {
  id             String          @id @default(cuid())
  businessId     String
  startDate      DateTime
  endDate        DateTime
  status         String          @default("open")
  totalTips      Float           @default(0)
  totalSales     Float           @default(0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relations
  payrollEntries PayrollEntry[]

  @@map("payroll_periods")
}

model PayrollEntry {
  id               String        @id @default(cuid())
  payrollPeriodId  String
  employeeId       String        // Reference to Employee
  regularHours     Float         @default(0)
  overtimeHours    Float         @default(0)
  regularPay       Float         @default(0)
  overtimePay      Float         @default(0)
  grossPay         Float         @default(0)
  totalTips        Float         @default(0)
  totalTaxes       Float         @default(0)
  netPay           Float         @default(0)
  hoursWorked      Float         @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee         Employee      @relation(fields: [employeeId], references: [id])

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_entries")
}

model PunchEvent {
  id          String   @id @default(cuid())
  businessId  String
  shiftId     String
  employeeId  String?  // Reference to Employee
  punchType   String   // 'clock_in', 'clock_out', 'break_start', 'break_end'
  punchTime   DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("punch_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  action      String   // 'CREATE', 'UPDATE', 'DELETE'
  entityType  String   // 'TIP_ENTRY', 'SHIFT', 'PAYROLL_PERIOD', etc.
  entityId    String
  oldValues   String?  // JSON string
  newValues   String?  // JSON string
  timestamp   DateTime @default(now())
  notes       String?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model AnalyticsEntry {
  id           String   @id @default(cuid())
  businessId   String
  eventType    String   // 'TIP_LOGGED', 'SHIFT_COMPLETED', 'PAYROLL_CALCULATED'
  eventData    String   // JSON string with event details
  deviceId     String?  // Hashed device identifier
  appVersion   String?
  timestamp    DateTime @default(now())
  transmitted  Boolean  @default(false)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("analytics_entries")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Enhanced Tip Management Models
model TipAuditLog {
  id              String    @id @default(cuid())
  tipEntryId      String
  businessId      String
  action          String    // 'create', 'update', 'delete', 'wage_adjustment'
  fieldChanged    String?   // Which field was changed
  oldValue        String?   // Previous value (JSON string)
  newValue        String?   // New value (JSON string)
  reason          String?   // Reason for change
  performedBy     String?   // User who made the change
  performedAt     DateTime  @default(now())
  ipAddress       String?   // For audit purposes
  userAgent       String?   // Browser/system info
  
  // Relations
  tipEntry        TipEntry  @relation(fields: [tipEntryId], references: [id], onDelete: Cascade)
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("tip_audit_logs")
}

model TipPoolDistribution {
  id              String    @id @default(cuid())
  businessId      String
  distributionDate DateTime
  totalAmount     Float
  distributionMethod String // 'hours_worked', 'equal_split', 'sales_percentage', 'custom'
  participants    Json     // Array of employee IDs and their allocations
  notes           String?
  status          String   @default("pending") // 'pending', 'approved', 'distributed', 'cancelled'
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tipEntries      TipEntry[]

  @@map("tip_pool_distributions")
}

model ComplianceCalculation {
  id                String    @id @default(cuid())
  businessId        String
  employeeId        String?
  calculationDate   DateTime
  payPeriodStart    DateTime
  payPeriodEnd      DateTime
  
  // Wage Calculations
  regularHours      Float     @default(0)
  overtimeHours     Float     @default(0)
  regularRate       Float     @default(0)
  tipWageRate       Float     @default(0) // Tipped minimum wage
  
  // Tip Calculations
  totalTips         Float     @default(0)
  tipCreditsUsed    Float     @default(0)
  wageShortfall     Float     @default(0) // Amount needed to meet minimum wage
  
  // Compliance Status
  meetsMinimumWage  Boolean   @default(false)
  requiresAdjustment Boolean  @default(false)
  adjustmentAmount  Float     @default(0)
  
  // IRS Reporting
  monthlyTipTotal   Float     @default(0)
  requiresIRSReporting Boolean @default(false)
  form4070Required  Boolean   @default(false)
  
  calculatedAt      DateTime  @default(now())
  calculatedBy      String?
  
  // Relations
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("compliance_calculations")
}

model TipImportLog {
  id              String    @id @default(cuid())
  businessId      String
  fileName        String
  fileSize        Int
  totalRows       Int
  successfulRows  Int
  failedRows      Int
  importedBy      String?
  importType      String    // 'csv', 'excel', 'pos_export'
  mappingConfig   Json      // Column mapping configuration
  errorLog        Json?     // Details of any import errors
  status          String    @default("processing") // 'processing', 'completed', 'failed', 'partial'
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  
  // Relations
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("tip_import_logs")
}

// Security Models
model RefreshToken {
  id            String    @id @default(cuid())
  tokenId       String    @unique  // Unique identifier from JWT payload
  userId        String
  businessId    String
  deviceInfo    String?   // User agent or device identifier
  ipAddress     String?   // IP address for security tracking
  isRevoked     Boolean   @default(false)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
