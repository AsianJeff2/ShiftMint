{
  "name": "shiftmint",
  "version": "2.1.0",
  "private": true,
  "description": "ShiftMint payroll and tip workspace for desktop and a private hosted business",
  "main": "dist-electron/electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --port 3000",
    "dev:backend": "node --env-file-if-exists=.env --import tsx electron/backend/server.ts",
    "dev:electron": "npm run build:electron && wait-on http://localhost:3000 && node scripts/dev-electron.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "npm run prisma:generate && npm run build:vite && npm run build:server",
    "build:vite": "tsc --noEmit -p tsconfig.json && vite build",
    "build:server": "node scripts/clean-build.cjs server && tsc -p tsconfig.server.json",
    "build:electron": "node scripts/clean-build.cjs electron && tsc -p electron/tsconfig.json",
    "build:production": "npm run build",
    "build:vite:prod": "npm run build:vite",
    "build:electron:prod": "npm run build:electron",
    "start": "node --env-file-if-exists=.env dist-server/electron/backend/server.js",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win-portable": "npm run build && electron-builder --win portable",
    "prisma:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-database.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "encrypt-data": "node --env-file-if-exists=.env --import tsx scripts/encrypt-existing-data.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "db:migrate:production": "node --env-file-if-exists=.env dist-server/scripts/migrate-database.js",
    "encrypt-data:production": "node --env-file-if-exists=.env dist-server/scripts/encrypt-existing-data.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "input-otp": "^1.4.2",
    "isomorphic-dompurify": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "winston": "^3.17.0",
    "zod": "^4.2.1"
  },
  "build": {
    "appId": "com.shiftmint.desktop",
    "productName": "ShiftMint",
    "copyright": "Copyright © 2026 ShiftMint",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "prisma/schema.prisma",
      "prisma/migrations/*/migration.sql",
      "prisma/migrations/migration_lock.toml",
      "assets/icon.png.png",
      "assets/icon.ico.ico",
      "assets/icon.icns",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": ["schema.prisma", "migrations/*/migration.sql", "migrations/migration_lock.toml"]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico.ico",
      "artifactName": "ShiftMint-${version}-${arch}.${ext}",
      "executableName": "ShiftMint",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "linux": {
      "category": "Office",
      "target": "AppImage",
      "icon": "assets/icon.png.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "perMachine": false,
      "installerIcon": "assets/icon.ico.ico",
      "uninstallerIcon": "assets/icon.ico.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ShiftMint",
      "menuCategory": "ShiftMint",
      "license": "LICENSE.txt",
      "warningsAsErrors": false,
      "artifactName": "shiftmint-setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "node_modules/**/*",
      "prisma/schema.prisma",
      "prisma/migrations/*/migration.sql",
      "prisma/migrations/migration_lock.toml"
    ]
  },
  "keywords": [
    "payroll",
    "tips",
    "restaurant",
    "employee-management",
    "local-first",
    "desktop-app"
  ],
  "author": "ShiftMint",
  "license": "UNLICENSED",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
